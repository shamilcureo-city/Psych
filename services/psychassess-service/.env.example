# PsychAssess Service Environment Variables

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://psychassess:psychassess_dev@localhost:5432/psychassess?schema=public"

# ─── Server ──────────────────────────────────────────────────
PORT=3029
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3004
APP_URL=http://localhost:3004

# ─── Redis (session cache, rate limiting) ────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication (JWT) ───────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# ─── Google OAuth ────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Razorpay ────────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── SMTP (Email) ────────────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@psychassess.com

# ─── Rate Limiting ──────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Crisis Event Publishing ────────────────────────────────
# KAFKA_BROKER=localhost:9092
# KAFKA_CRISIS_TOPIC=psychassess_crisis_flag

# ─── File Storage (S3-compatible) ───────────────────────────
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=psychassess-files
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug
