generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  passwordHash   String?   // null for OAuth-only users
  googleId       String?   @unique
  avatarUrl      String?
  role           String    @default("USER") // USER, THERAPIST, ADMIN
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription   Subscription?
  sessions       AssessmentSession[]
  results        AssessmentResult[]
  moodLogs       MoodLog[]
  scoreHistory   ClientScoreHistory[]
  crisisEvents   CrisisEvent[]
  journalEntries JournalEntry[]
  shareLinks     ShareLink[]

  @@index([email])
  @@index([googleId])
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  plan               String    @default("FREE") // FREE, WELLNESS, CLINICAL
  status             String    @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, TRIALING
  razorpayCustomerId String?
  razorpaySubId      String?   @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([razorpaySubId])
  @@index([status])
}

model ShareLink {
  id         String    @id @default(uuid())
  userId     String
  resultId   String
  token      String    @unique @default(uuid())
  expiresAt  DateTime?
  viewCount  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  result AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════
//  ASSESSMENT
// ═══════════════════════════════════════════════════════════════

model AssessmentSession {
  id            String              @id @default(uuid())
  clientId      String
  userId        String?
  toolType      String
  status        String              @default("IN_PROGRESS")
  adaptivePath  String[]            @default([])
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  responses AssessmentResponse[]
  result    AssessmentResult?

  @@index([clientId])
  @@index([userId])
  @@index([clientId, toolType])
  @@index([status])
}

model AssessmentResponse {
  id            String   @id @default(uuid())
  sessionId     String
  questionId    String
  questionText  String
  responseValue Int
  responseText  String
  scoredValue   Int
  answeredAt    DateTime @default(now())

  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
}

model AssessmentResult {
  id                         String   @id @default(uuid())
  sessionId                  String   @unique
  clientId                   String
  userId                     String?
  toolType                   String
  totalScore                 Int
  maxPossibleScore           Int
  subscaleScores             Json?
  severityBand               String
  severityLabel              String
  clinicalInterpretation     String
  plainLanguageInterpretation String
  recommendation             String
  riskLevel                  String   @default("NONE")
  crisisFlags                Json?
  adaptiveSuggestions        String[] @default([])
  createdAt                  DateTime @default(now())

  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  shareLinks ShareLink[]

  @@index([clientId])
  @@index([userId])
  @@index([clientId, toolType])
  @@index([riskLevel])
}

// ═══════════════════════════════════════════════════════════════
//  VOICE / CRISIS / MOOD / JOURNAL / HISTORY
// ═══════════════════════════════════════════════════════════════

model VoiceSession {
  id             String        @id @default(uuid())
  clientId       String
  sessionType    String
  framework      String
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  durationSec    Int?
  transcriptRef  String?
  notesRef       String?
  crisisFlag     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  crisisEvents   CrisisEvent[]

  @@index([clientId])
}

model CrisisEvent {
  id             String    @id @default(uuid())
  clientId       String
  userId         String?
  sessionId      String?
  voiceSessionId String?
  flagType       String
  severity       String
  description    String?
  triggeredAt    DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  safetyPlanRef  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  voiceSession VoiceSession? @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([severity])
  @@index([triggeredAt])
}

model MoodLog {
  id        String   @id @default(uuid())
  clientId  String
  userId    String?
  logDate   DateTime @default(now())
  moodScore Int
  note      String?
  tags      String[] @default([])
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@index([clientId, logDate])
}

model JournalEntry {
  id         String   @id @default(uuid())
  clientId   String
  userId     String?
  entryDate  DateTime @default(now())
  content    String
  promptUsed String?
  sentiment  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@index([clientId, entryDate])
}

model ClientScoreHistory {
  id           String   @id @default(uuid())
  clientId     String
  userId       String?
  toolType     String
  score        Int
  severityBand String
  assessedAt   DateTime @default(now())
  sessionId    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([userId])
  @@index([clientId, toolType])
  @@index([clientId, toolType, assessedAt])
}
